# Servidor
PORT=4000
# Orígenes permitidos por CORS (separados por coma). Vacío = cualquiera (solo desarrollo).
CORS_ORIGIN=

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_postgres
DB_NAME=hotel_pms

# Autenticación (obligatoria si NODE_ENV=production)
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# Zona horaria del hotel: define qué es "hoy" para validar fechas (check-in, no-show, reservas)
TZ_NEGOCIO=America/Mexico_City

# Dirección donde se abre el PMS. Va dentro del QR de cada reserva: debe alcanzarla el celular
# de quien escanea (IP de tu PC en la red, p. ej. http://192.168.1.50:5173, o tu dominio con HTTPS).
URL_PUBLICA=http://localhost:5173

# Correo saliente (QR de la reserva). Gmail: usa una contraseña de aplicación. Si SMTP_HOST está vacío, no se envían correos.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# false = no enviar automáticamente al crear una reserva (el botón manual sigue disponible)
ENVIAR_QR_AUTOMATICO=true
